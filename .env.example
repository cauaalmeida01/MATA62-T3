# Copie para .env (cp .env.example .env) e troque os segredos.
# Os nomes de host (postgres, elasticmq, rustfs, mailpit, *-api) valem dentro do Docker Compose.

# PostgreSQL compartilhado (ADR-005 do T2; um esquema por serviço, ver docs/contratos.md)
POSTGRES_USER=veridit
POSTGRES_PASSWORD=veridit
POSTGRES_DB=veridit
DATABASE_URL=postgresql://veridit:veridit@postgres:5432/veridit

# Fila de captura: ElasticMQ, com a mesma API do Amazon SQS (ADR-002 do T2 + desvio pendente)
SQS_ENDPOINT=http://elasticmq:9324
SQS_REGION=elasticmq
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x
FILA_CAPTURA_URL=http://elasticmq:9324/000000000000/captura
FILA_CAPTURA_DLQ_URL=http://elasticmq:9324/000000000000/captura-dlq

# Armazenamento de evidências: RustFS com Object Lock, mesma API do S3 (ADR-003 do T2 + desvio pendente)
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=veridit
S3_SECRET_KEY=veridit-s3-123
S3_BUCKET_EVIDENCIAS=evidencias

# Carimbo do tempo RFC 3161 (FreeTSA no lugar da ACT ICP-Brasil; desvio pendente)
TSA_URL=https://freetsa.org/tsr

# E-mail (Mailpit no lugar do Amazon SES)
SMTP_HOST=mailpit
SMTP_PORT=1025

# Autenticação (JWT próprio no lugar do Cognito; desvio pendente)
JWT_SECRET=troque-este-segredo
JWT_EXPIRA_EM=1h

# Cifragem do CPF (chave em variável de ambiente no lugar do AWS KMS; desvio pendente)
CPF_CHAVE_CIFRAGEM=troque-esta-chave

# Créditos de teste criados no cadastro (a compra, REQ05/REQ06, está fora da sprint)
CREDITOS_INICIAIS=5

# Endereços internos entre serviços (rotas /api/internal/*, não expostas pelo Nginx)
CONTAS_URL=http://contas-api:3000/api
CREDITOS_URL=http://creditos-api:3000/api
EVIDENCIA_URL=http://evidencia-api:3000/api
RELATORIOS_URL=http://relatorios-api:3000/api
