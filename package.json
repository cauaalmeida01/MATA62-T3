{
  "name": "veridit-t3",
  "version": "0.1.0",
  "private": true,
  "description": "Veridit - Trabalho III (MATA62/UFBA): implementação da arquitetura baseada em serviços do Grupo 4 (T2)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "for app in contas-api creditos-api registro-api captura-worker evidencia-api relatorios-api; do nest build $app || exit 1; done",
    "build:app": "nest build",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1166.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/compartilhado(|/.*)$": "<rootDir>/libs/compartilhado/src/$1",
      "^@app/infra(|/.*)$": "<rootDir>/libs/infra/src/$1"
    },
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22"
  }
}
